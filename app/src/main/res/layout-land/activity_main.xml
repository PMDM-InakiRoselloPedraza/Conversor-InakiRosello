<?xml version="1.0" encoding="utf-8"?>
<!-- TODO: Activ 5.1 Layout horizontal específico: dos columnas (datos | resultado) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meter_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:weightSum="2"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView_Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/textViewInfo"
            android:textColor="#0000ff"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/sp_Conversion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:entries="@array/conversiones"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/et_Valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ems="10"
            android:gravity="center"
            android:hint="@string/hintValor"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/ib_Ayuda"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/ayuda"
            android:src="@android:drawable/ic_menu_help" />

        <Button
            android:id="@+id/button_Convertir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buttonConvertir" />

        <TextView
            android:id="@+id/tv_Resultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:textColor="#0000ff"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FF0000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_Valoracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/valora_titulo"
            android:textColor="#0000ff"
            android:textSize="16sp" />

        <RatingBar
            android:id="@+id/rating_Bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1" />
    </LinearLayout>

</LinearLayout>